---
// Non-simulator slide visuals. Animations restart whenever the slide becomes active
// (the deck runtime toggles `.is-active` on the wrapper).
import type { Visual } from '../lib/deck-types';
import { resultShotMarkup } from '../lib/shot';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  visual: Exclude<Visual, { kind: 'sim' }>;
  locale: Locale;
  xp: number;
}

const { visual, locale, xp } = Astro.props;
const t = useTranslations(locale);
---

{
  visual.kind === 'flow' && (
    <div class="v-flow">
      {visual.steps.map((s, i) => (
        <div class="v-flow__step" style={`--i:${i}`}>
          <span class="v-flow__node">
            <span class="v-flow__icon">{s.icon}</span>
          </span>
          <span class="v-flow__label">
            <span class="hud">{String(i + 1).padStart(2, '0')}</span>
            {s.label}
          </span>
        </div>
      ))}
    </div>
  )
}

{
  visual.kind === 'shot' && (
    <div class="v-shot">
      <div class="v-shot__device">
        <Fragment set:html={resultShotMarkup({ callouts: true })} />
        <span class="v-shot__flash" />
      </div>
      <div class="v-shot__legend">
        <span>
          <b>1</b> Skor
        </span>
        <span>
          <b>2</b> Pemenang
        </span>
        <span>
          <b>3</b> Match ID
        </span>
      </div>
    </div>
  )
}

{
  visual.kind === 'deadline' && (
    <div class="v-deadline">
      <div class="v-deadline__clock" aria-hidden="true">
        <span class="v-deadline__hand v-deadline__hand--m" />
        <span class="v-deadline__hand v-deadline__hand--h" />
      </div>
      <div class="v-deadline__ts">
        <span class="hud">{visual.label}</span>
        <span class="v-deadline__chip">dalam 2 jam</span>
      </div>
      <div class="v-deadline__zones">
        {visual.zones.map((z, i) => (
          <div class="v-deadline__zone glass" style={`--i:${i}`}>
            <span class="hud">{z.zone}</span>
            <b>{z.time}</b>
          </div>
        ))}
      </div>
      <p class="v-deadline__note">Satu batas waktu, tampil sesuai jam di perangkatmu.</p>
    </div>
  )
}

{
  visual.kind === 'recap' && (
    <div class="v-recap">
      <div class="v-recap__card glass">
        <div class="v-recap__head">
          <span class="hud hud--yellow">Format laporan</span>
          <button class="btn btn--ghost v-recap__copy" type="button" data-copy={visual.template} data-copied={t('copy.copied')}>
            {t('copy.copy')}
          </button>
        </div>
        <pre class="v-recap__tpl">{visual.template}</pre>
      </div>
      <div class="v-recap__reward">
        <div class="v-recap__medal" aria-hidden="true">★</div>
        <div>
          <span class="hud">Hadiah misi</span>
          <b class="glow-yellow">+{xp} XP</b>
        </div>
        <button class="btn btn--primary" type="button" data-claim>
          {t('deck.finish')}
        </button>
      </div>
    </div>
  )
}

<style>
  /* flow ------------------------------------------------------------------ */
  .v-flow {
    position: relative;
    display: grid;
    gap: 14px;
    width: min(420px, 100%);
    margin: auto;
    padding: 12px 0;
  }

  .v-flow::before {
    content: '';
    position: absolute;
    left: 31px;
    top: 40px;
    bottom: 40px;
    width: 18px;
    background: repeating-linear-gradient(90deg, var(--blue-glow) 0 2px, transparent 2px 4px);
    opacity: 0.8;
    transform-origin: top;
  }

  :global(.is-active) > .v-flow::before {
    animation: flow-line 2.6s ease forwards;
  }

  .v-flow__step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .v-flow__node {
    display: grid;
    place-items: center;
    width: 80px;
    height: 64px;
    flex: none;
  }

  .v-flow__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-size: 1.6rem;
    background: var(--navy-800);
    border: 2px solid var(--line-strong);
    box-shadow: 0 0 0 6px var(--navy-950);
  }

  .v-flow__label {
    display: flex;
    flex-direction: column;
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1.2;
  }

  :global(.is-active) > .v-flow .v-flow__step {
    animation: flow-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--i) * 0.45s);
  }

  :global(.is-active) > .v-flow .v-flow__icon {
    animation: flow-node 0.5s ease both;
    animation-delay: calc(var(--i) * 0.45s + 0.2s);
  }

  @keyframes flow-line {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes flow-in {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
  }

  @keyframes flow-node {
    to {
      background: var(--yellow);
      border-color: var(--yellow);
      box-shadow:
        0 0 0 6px var(--navy-950),
        0 0 30px rgb(255 188 0 / 0.5);
    }
  }

  /* screenshot ----------------------------------------------------------- */
  .v-shot {
    display: grid;
    gap: 18px;
    width: min(560px, 100%);
    margin: auto;
  }

  .v-shot__device {
    position: relative;
    padding: 10px;
    border-radius: 22px;
    background: #05061a;
    box-shadow:
      0 0 0 2px rgb(47 140 255 / 0.5),
      0 30px 60px -20px #000;
    font-size: clamp(7px, 1.6vw, 11px);
  }

  .v-shot__device :global(.shot) {
    border-radius: 14px;
    font-size: 1em;
  }

  .v-shot__flash {
    position: absolute;
    inset: 10px;
    border-radius: 14px;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  :global(.is-active) > .v-shot .v-shot__flash {
    animation: shot-flash 0.7s ease 0.5s;
  }

  .v-shot__device :global(.shot__callout) {
    transform: scale(0);
  }

  :global(.is-active) > .v-shot :global(.shot__callout) {
    animation: callout-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  :global(.is-active) > .v-shot :global(.shot__callout[data-n='1']) {
    animation-delay: 1.4s;
  }

  :global(.is-active) > .v-shot :global(.shot__callout[data-n='2']) {
    animation-delay: 2.2s;
  }

  :global(.is-active) > .v-shot :global(.shot__callout[data-n='3']) {
    animation-delay: 3s;
  }

  .v-shot__legend {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-weight: 700;
  }

  .v-shot__legend b {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--navy-950);
    font-size: 0.8rem;
  }

  @keyframes shot-flash {
    0% {
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes callout-pop {
    to {
      transform: scale(1);
    }
  }

  /* deadline -------------------------------------------------------------- */
  .v-deadline {
    display: grid;
    justify-items: center;
    gap: 20px;
    margin: auto;
    text-align: center;
  }

  .v-deadline__clock {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid var(--blue-glow);
    box-shadow:
      0 0 0 10px rgb(47 140 255 / 0.12),
      0 0 40px rgb(47 140 255 / 0.4);
    background: repeating-conic-gradient(from 0deg, rgb(255 255 255 / 0.4) 0 1deg, transparent 1deg 30deg);
  }

  .v-deadline__hand {
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 4px;
    margin-left: -2px;
    border-radius: 2px;
    transform-origin: bottom center;
  }

  .v-deadline__hand--m {
    height: 46px;
    background: var(--white);
    animation: hand 3s linear infinite;
  }

  .v-deadline__hand--h {
    height: 30px;
    background: var(--yellow);
    animation: hand 36s linear infinite;
  }

  @keyframes hand {
    to {
      transform: rotate(360deg);
    }
  }

  .v-deadline__ts {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .v-deadline__chip {
    padding: 4px 10px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.1);
    font-weight: 800;
    font-size: 1.2rem;
  }

  .v-deadline__zones {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .v-deadline__zone {
    display: grid;
    gap: 2px;
    min-width: 100px;
    padding: 12px 16px;
  }

  .v-deadline__zone b {
    font-size: 1.6rem;
    font-weight: 900;
  }

  :global(.is-active) > .v-deadline .v-deadline__zone {
    animation: flow-in 0.5s ease both;
    animation-delay: calc(0.6s + var(--i) * 0.3s);
  }

  .v-deadline__note {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  /* recap ----------------------------------------------------------------- */
  .v-recap {
    display: grid;
    gap: 18px;
    width: min(460px, 100%);
    margin: auto;
  }

  .v-recap__card {
    padding: 18px;
  }

  .v-recap__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .v-recap__copy {
    min-height: 38px;
    padding: 0.4em 1em;
    font-size: 0.75rem;
  }

  .v-recap__tpl {
    margin: 0;
    padding: 14px;
    border-radius: 8px;
    background: #1e1f22;
    color: #dbdee1;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    white-space: pre-wrap;
  }

  .v-recap__reward {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .v-recap__reward > div {
    display: grid;
    flex: 1;
  }

  .v-recap__reward b {
    font-size: 1.6rem;
    font-weight: 900;
    font-style: italic;
  }

  .v-recap__medal {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff3c4, var(--yellow) 55%, #c98f00);
    color: var(--navy-950);
    font-size: 1.5rem;
    box-shadow: 0 0 30px rgb(255 188 0 / 0.5);
  }

  :global(.is-active) > .v-recap .v-recap__medal {
    animation: medal 1.6s ease-in-out infinite;
  }

  @keyframes medal {
    50% {
      transform: translateY(-4px) rotate(-8deg);
    }
  }
</style>
