---
// Non-simulator slide visuals. Animations restart whenever the slide becomes active
// (the deck runtime toggles `.is-active` on the wrapper).
import type { Visual } from '../lib/deck-types';
import { resultShotMarkup } from '../lib/shot';
import { md } from '../lib/md';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  visual: Exclude<Visual, { kind: 'sim' }>;
  locale: Locale;
  xp: number;
  badge: string;
}

const { visual, locale, xp, badge } = Astro.props;
const t = useTranslations(locale);
---

{
  visual.kind === 'flow' && (
    <div class="v-flow">
      {visual.steps.map((s, i) => (
        <div class="v-flow__step" style={`--i:${i}`}>
          <span class="v-flow__node">
            <span class="v-flow__icon">{s.icon}</span>
          </span>
          <span class="v-flow__label">
            <span class="hud">{String(i + 1).padStart(2, '0')}</span>
            {s.label}
          </span>
        </div>
      ))}
    </div>
  )
}

{
  visual.kind === 'shot' && (
    <div class="v-shot">
      <div class="v-shot__device">
        <Fragment set:html={resultShotMarkup({ callouts: true })} />
        <span class="v-shot__flash" />
      </div>
      <div class="v-shot__legend">
        <span>
          <b>1</b> Skor
        </span>
        <span>
          <b>2</b> Pemenang
        </span>
        <span>
          <b>3</b> Match ID
        </span>
      </div>
    </div>
  )
}

{
  visual.kind === 'zones' && (
    <div class="v-deadline">
      <div class="v-deadline__clock" aria-hidden="true">
        <span class="v-deadline__hand v-deadline__hand--m" />
        <span class="v-deadline__hand v-deadline__hand--h" />
      </div>
      <div class="v-deadline__ts">
        <span class="hud">{visual.label}</span>
        <span class="v-deadline__chip">{visual.chip}</span>
      </div>
      <div class="v-deadline__zones">
        {visual.zones.map((z, i) => (
          <div class="v-deadline__zone glass" style={`--i:${i}`}>
            <span class="hud">{z.zone}</span>
            <b>{z.time}</b>
          </div>
        ))}
      </div>
      <p class="v-deadline__note">{visual.note}</p>
    </div>
  )
}

{
  visual.kind === 'recap' && (
    <div class="v-recap">
      {visual.template && (
        <div class="v-recap__card glass">
          <div class="v-recap__head">
            <span class="hud hud--yellow">Format pesan</span>
            <button class="btn btn--ghost v-recap__copy" type="button" data-copy={visual.template} data-copied={t('copy.copied')}>
              {t('copy.copy')}
            </button>
          </div>
          <pre class="v-recap__tpl">{visual.template}</pre>
        </div>
      )}
      <div class="v-recap__badge glass hud-corners">
        <span class="hud">{t('toast.badge')}</span>
        <b>{badge}</b>
      </div>
      <div class="v-recap__reward">
        <div class="v-recap__medal" aria-hidden="true">★</div>
        <div>
          <span class="hud">XP misi</span>
          <b class="glow-yellow">+{xp} XP</b>
        </div>
        <button class="btn btn--primary" type="button" data-claim>
          {t('deck.finish')}
        </button>
      </div>
    </div>
  )
}


{
  visual.kind === 'cards' && (
    <div class:list={['v-cards', { 'v-cards--2': visual.cards.length === 4 || visual.cards.length === 2 }]}>
      {visual.cards.map((c, i) => (
        <div class="v-card glass" style={`--i:${i}`}>
          <span class="v-card__icon">{c.icon}</span>
          <b class="v-card__title" set:html={md(c.title)} />
          <span class="v-card__text" set:html={md(c.text)} />
        </div>
      ))}
    </div>
  )
}

{
  visual.kind === 'concept' && (
    <div class="v-concept">
      {visual.levels.map((l, i) => (
        <div class="v-concept__level" style={`--i:${i}`}>
          <span class="v-concept__icon">{l.icon}</span>
          <span class="v-concept__text">
            <span class="hud hud--yellow">{l.label}</span>
            <b>{l.name}</b>
          </span>
        </div>
      ))}
    </div>
  )
}

{
  visual.kind === 'form' && (
    <div class="v-form">
      <div class="v-form__box">
        <div class="v-form__title">{visual.title}</div>
        {visual.fields.map((f, i) => (
          <label class="v-form__field" style={`--i:${i}`}>
            <span>{f.label}</span>
            <span class="v-form__input">
              <span class="v-form__value">{f.value}</span>
            </span>
          </label>
        ))}
        <span class="v-form__btn" style={`--i:${visual.fields.length}`}>
          {visual.button}
        </span>
      </div>
    </div>
  )
}

{
  visual.kind === 'note' && (
    <div class="v-note">
      <div class="v-note__app hud">{visual.app}</div>
      <div class="v-note__card">
        <div class="v-note__from">
          <span class="v-note__avatar">{visual.from.slice(0, 1)}</span>
          <div>
            <b>{visual.from}</b>
            <small>baru saja</small>
          </div>
        </div>
        <div class="v-note__title">{visual.title}</div>
        <p class="v-note__body" set:html={md(visual.body)} />
        {visual.button && <span class="v-note__btn">{visual.button}</span>}
      </div>
    </div>
  )
}

{
  visual.kind === 'formdone' && (
    <div class="v-done">
      <div class="v-done__app hud">{visual.app}</div>
      <div class="v-done__page">
        <div class="v-done__banner" />
        <div class="v-done__body">
          <div class="v-done__form">{visual.form}</div>
          <div class="v-done__ok">
            <span class="v-done__check">✓</span>
            Tanggapan kamu sudah terkirim
          </div>
          <p class="v-done__msg" set:html={md(visual.message)} />
          <span class="v-done__link">
            🔗 {visual.link}
            <span class="v-done__tap" aria-hidden="true" />
          </span>
          <span class="v-done__hint">{visual.linkLabel}</span>
        </div>
      </div>
    </div>
  )
}

<style>
  /* cards ----------------------------------------------------------------- */
  .v-cards {
    display: grid;
    gap: 12px;
    width: min(560px, 100%);
    margin: auto;
  }

  .v-cards--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .v-card {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px 18px;
  }

  :global(.is-active) > .v-cards .v-card {
    animation: flow-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(0.2s + var(--i) * 0.25s);
  }

  .v-card__icon {
    font-size: 1.8rem;
    line-height: 1.2;
  }

  .v-card__title {
    font-size: 1.05rem;
    font-weight: 900;
    line-height: 1.25;
  }

  .v-card__text {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .v-card__text :global(code),
  .v-card__title :global(code) {
    white-space: normal;
  }

  /* concept --------------------------------------------------------------- */
  .v-concept {
    display: grid;
    gap: 10px;
    width: min(440px, 100%);
    margin: auto;
  }

  .v-concept__level {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: calc(var(--i) * 34px);
    padding: 12px 16px;
    border-radius: 12px;
    background: linear-gradient(90deg, rgb(0 97 175 / 0.45), rgb(0 97 175 / 0.1));
    border: 1px solid rgb(47 140 255 / 0.45);
    position: relative;
  }

  .v-concept__level + .v-concept__level::before {
    content: '';
    position: absolute;
    left: -20px;
    top: -34px;
    width: 18px;
    height: 58px;
    border-left: 2px solid var(--blue-glow);
    border-bottom: 2px solid var(--blue-glow);
    border-bottom-left-radius: 10px;
  }

  :global(.is-active) > .v-concept .v-concept__level {
    animation: flow-in 0.5s ease both;
    animation-delay: calc(0.2s + var(--i) * 0.5s);
  }

  .v-concept__icon {
    font-size: 1.6rem;
  }

  .v-concept__text {
    display: grid;
  }

  .v-concept__text b {
    font-size: 1.05rem;
  }

  /* form ------------------------------------------------------------------ */
  .v-form {
    width: min(380px, 100%);
    margin: auto;
  }

  .v-form__box {
    display: grid;
    gap: 10px;
    padding: 22px;
    border-radius: 12px;
    background: #313338;
    color: #dbdee1;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08), 0 30px 60px -20px #000;
  }

  .v-form__title {
    text-align: center;
    font-size: 1.3rem;
    font-weight: 800;
    color: #f2f3f5;
    margin-bottom: 4px;
  }

  .v-form__field {
    display: grid;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #b5bac1;
  }

  .v-form__input {
    display: block;
    height: 38px;
    padding: 8px 10px;
    border-radius: 4px;
    background: #1e1f22;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: #f2f3f5;
    overflow: hidden;
  }

  .v-form__value {
    display: inline-block;
    white-space: nowrap;
    overflow: hidden;
    vertical-align: top;
  }

  :global(.is-active) > .v-form .v-form__value {
    animation: type-in 0.9s steps(18) both;
    animation-delay: calc(0.4s + var(--i) * 1s);
  }

  :global(.is-active) > .v-form .v-form__field {
    animation: field-focus 1s ease both;
    animation-delay: calc(0.4s + var(--i) * 1s);
  }

  .v-form__btn {
    display: grid;
    place-items: center;
    height: 42px;
    margin-top: 6px;
    border-radius: 4px;
    background: #5865f2;
    color: #fff;
    font-weight: 700;
  }

  :global(.is-active) > .v-form .v-form__btn {
    animation: btn-press 0.5s ease both;
    animation-delay: calc(0.6s + var(--i) * 1s);
  }

  @keyframes type-in {
    from {
      max-width: 0;
    }
    to {
      max-width: 100%;
    }
  }

  @keyframes field-focus {
    0%,
    100% {
      color: #b5bac1;
    }
    30% {
      color: var(--yellow);
    }
  }

  @keyframes btn-press {
    50% {
      transform: scale(0.95);
      box-shadow: 0 0 0 6px rgb(255 188 0 / 0.6);
    }
  }

  /* note (email / chat message) ------------------------------------------ */
  .v-note {
    display: grid;
    gap: 10px;
    width: min(420px, 100%);
    margin: auto;
  }

  .v-note__card {
    display: grid;
    gap: 10px;
    padding: 18px 20px;
    border-radius: 14px;
    background: #f4f6fb;
    color: #1d2333;
    box-shadow: 0 30px 60px -20px #000;
  }

  :global(.is-active) > .v-note .v-note__card {
    animation: flow-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .v-note__from {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .v-note__from small {
    display: block;
    color: #6b7280;
    font-size: 0.75rem;
  }

  .v-note__avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    font-weight: 800;
  }

  .v-note__title {
    font-weight: 800;
    font-size: 1.05rem;
  }

  .v-note__body {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .v-note__body :global(code) {
    background: #e3e8f4;
    border-color: #cfd6e6;
    color: #0061af;
    white-space: normal;
  }

  .v-note__btn {
    justify-self: start;
    padding: 8px 18px;
    border-radius: 6px;
    background: #5865f2;
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
  }

  :global(.is-active) > .v-note .v-note__btn {
    animation: btn-press 0.6s ease 1.6s both;
  }


  /* form confirmation page ------------------------------------------------ */
  .v-done {
    display: grid;
    gap: 10px;
    width: min(440px, 100%);
    margin: auto;
  }

  .v-done__page {
    overflow: hidden;
    border-radius: 12px;
    background: #f4f6fb;
    color: #1d2333;
    box-shadow: 0 30px 60px -20px #000;
  }

  :global(.is-active) > .v-done .v-done__page {
    animation: flow-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .v-done__banner {
    height: 56px;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.18) 0 4px, transparent 4px 10px),
      linear-gradient(90deg, #0061af, #2f8cff);
  }

  .v-done__body {
    display: grid;
    gap: 12px;
    padding: 18px 22px 22px;
  }

  .v-done__form {
    font-weight: 800;
    font-size: 1.1rem;
  }

  .v-done__ok {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: #107c41;
  }

  .v-done__check {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #107c41;
    color: #fff;
    font-size: 0.85rem;
  }

  :global(.is-active) > .v-done .v-done__check {
    animation: callout-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s both;
  }

  .v-done__msg {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .v-done__link {
    position: relative;
    justify-self: start;
    padding: 10px 14px;
    border-radius: 8px;
    background: #e6efff;
    border: 1px solid #b9cff5;
    color: #0061af;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: underline;
  }

  :global(.is-active) > .v-done .v-done__link {
    animation: btn-press 0.6s ease 2s both;
  }

  .v-done__tap {
    position: absolute;
    right: -10px;
    bottom: -14px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgb(255 188 0 / 0.5);
    border: 2px solid #ffbc00;
    opacity: 0;
  }

  :global(.is-active) > .v-done .v-done__tap {
    animation: done-tap 1.2s ease 1.6s both;
  }

  @keyframes done-tap {
    0% {
      opacity: 0;
      transform: translate(20px, 20px);
    }
    40%,
    70% {
      opacity: 1;
      transform: none;
    }
    55% {
      transform: scale(0.8);
    }
    100% {
      opacity: 0;
    }
  }

  .v-done__hint {
    font-size: 0.8rem;
    color: #6b7280;
  }

  /* recap badge ----------------------------------------------------------- */
  .v-recap__badge {
    display: grid;
    gap: 2px;
    padding: 14px 18px;
  }

  .v-recap__badge b {
    font-size: 1.3rem;
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
  }

  @media (max-width: 520px) {
    .v-cards--2 {
      grid-template-columns: 1fr;
    }
  }

  /* flow ------------------------------------------------------------------ */
  .v-flow {
    position: relative;
    display: grid;
    gap: 14px;
    width: min(420px, 100%);
    margin: auto;
    padding: 12px 0;
  }

  .v-flow::before {
    content: '';
    position: absolute;
    left: 31px;
    top: 40px;
    bottom: 40px;
    width: 18px;
    background: repeating-linear-gradient(90deg, var(--blue-glow) 0 2px, transparent 2px 4px);
    opacity: 0.8;
    transform-origin: top;
  }

  :global(.is-active) > .v-flow::before {
    animation: flow-line 2.6s ease forwards;
  }

  .v-flow__step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .v-flow__node {
    display: grid;
    place-items: center;
    width: 80px;
    height: 64px;
    flex: none;
  }

  .v-flow__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-size: 1.6rem;
    background: var(--navy-800);
    border: 2px solid var(--line-strong);
    box-shadow: 0 0 0 6px var(--navy-950);
  }

  .v-flow__label {
    display: flex;
    flex-direction: column;
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1.2;
  }

  :global(.is-active) > .v-flow .v-flow__step {
    animation: flow-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--i) * 0.45s);
  }

  :global(.is-active) > .v-flow .v-flow__icon {
    animation: flow-node 0.5s ease both;
    animation-delay: calc(var(--i) * 0.45s + 0.2s);
  }

  @keyframes flow-line {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes flow-in {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
  }

  @keyframes flow-node {
    to {
      background: var(--yellow);
      border-color: var(--yellow);
      box-shadow:
        0 0 0 6px var(--navy-950),
        0 0 30px rgb(255 188 0 / 0.5);
    }
  }

  /* screenshot ----------------------------------------------------------- */
  .v-shot {
    display: grid;
    gap: 18px;
    width: min(560px, 100%);
    margin: auto;
  }

  .v-shot__device {
    position: relative;
    padding: 10px;
    border-radius: 22px;
    background: #05061a;
    box-shadow:
      0 0 0 2px rgb(47 140 255 / 0.5),
      0 30px 60px -20px #000;
    font-size: clamp(7px, 1.6vw, 11px);
  }

  .v-shot__device :global(.shot) {
    border-radius: 14px;
    font-size: 1em;
  }

  .v-shot__flash {
    position: absolute;
    inset: 10px;
    border-radius: 14px;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  :global(.is-active) > .v-shot .v-shot__flash {
    animation: shot-flash 0.7s ease 0.5s;
  }

  .v-shot__device :global(.shot__callout) {
    transform: scale(0);
  }

  :global(.is-active) > .v-shot :global(.shot__callout) {
    animation: callout-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  :global(.is-active) > .v-shot :global(.shot__callout[data-n='1']) {
    animation-delay: 1.4s;
  }

  :global(.is-active) > .v-shot :global(.shot__callout[data-n='2']) {
    animation-delay: 2.2s;
  }

  :global(.is-active) > .v-shot :global(.shot__callout[data-n='3']) {
    animation-delay: 3s;
  }

  .v-shot__legend {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-weight: 700;
  }

  .v-shot__legend b {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--navy-950);
    font-size: 0.8rem;
  }

  @keyframes shot-flash {
    0% {
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes callout-pop {
    to {
      transform: scale(1);
    }
  }

  /* deadline -------------------------------------------------------------- */
  .v-deadline {
    display: grid;
    justify-items: center;
    gap: 20px;
    margin: auto;
    text-align: center;
  }

  .v-deadline__clock {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid var(--blue-glow);
    box-shadow:
      0 0 0 10px rgb(47 140 255 / 0.12),
      0 0 40px rgb(47 140 255 / 0.4);
    background: repeating-conic-gradient(from 0deg, rgb(255 255 255 / 0.4) 0 1deg, transparent 1deg 30deg);
  }

  .v-deadline__hand {
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 4px;
    margin-left: -2px;
    border-radius: 2px;
    transform-origin: bottom center;
  }

  .v-deadline__hand--m {
    height: 46px;
    background: var(--white);
    animation: hand 3s linear infinite;
  }

  .v-deadline__hand--h {
    height: 30px;
    background: var(--yellow);
    animation: hand 36s linear infinite;
  }

  @keyframes hand {
    to {
      transform: rotate(360deg);
    }
  }

  .v-deadline__ts {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .v-deadline__chip {
    padding: 4px 10px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.1);
    font-weight: 800;
    font-size: 1.2rem;
  }

  .v-deadline__zones {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .v-deadline__zone {
    display: grid;
    gap: 2px;
    min-width: 100px;
    padding: 12px 16px;
  }

  .v-deadline__zone b {
    font-size: 1.6rem;
    font-weight: 900;
  }

