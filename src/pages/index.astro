---
import Base from '../layouts/Base.astro';
import Ribbon from '../components/Ribbon.astro';
import MissionMap from '../components/MissionMap.astro';
import HeroDemo from '../components/HeroDemo.astro';
import TournamentInfo from '../components/TournamentInfo.astro';
import { meander } from '../lib/ribbon';
import { missions, games } from '../data/missions';
import { useTranslations, defaultLocale } from '../i18n/ui';

const locale = defaultLocale;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const list = missions[locale];
const first = list[0];
const report = list.find((m) => m.slug === 'lapor-hasil')!;
const keyMissions = list.filter((m) => m.key);

// Decorative arches behind the demo phone, like the HORI 80 cover.
const hero = meander({ x: 60, baseline: 760, r: 62, apexY: [250, 800, 70, 800, 330, 800, 160] });
const heroDots = [
  { x: 184, y: 520 },
  { x: 432, y: 300, front: true },
  { x: 804, y: 580 },
];

const how = [
  { no: '01', title: 'Pilih misi', text: 'Setiap misi membahas satu hal, 2–4 menit saja.' },
  { no: '02', title: 'Tonton atau coba', text: 'Tonton seperti video, atau praktikkan langsung di tampilan Discord.' },
  { no: '03', title: 'Kumpulkan XP', text: 'Selesaikan misi untuk naik pangkat dan dapat lencana.' },
];

const why = [
  {
    icon: '🏠',
    title: 'Satu rumah komunitas',
    text: 'Server Discord ini akan jadi rumah Treasury E-Sport Community setelah kompetisi selesai.',
  },
  {
    icon: '👀',
    title: 'Transparan',
    text: 'Setiap laga punya thread publik: jadwal, obrolan, dan hasilnya bisa dilihat semua orang.',
  },
  {
    icon: '⏰',
    title: 'Jam otomatis sesuai zonamu',
    text: 'Jadwal di Discord tampil sesuai jam di perangkatmu, baik WIB, WITA, maupun WIT.',
  },
];
---

<Base locale={locale}>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="hud hud--yellow">// {t('site.community')}</p>
        <h1 class="hero__title">
          <span class="display hero__l1">Panduan Interaktif</span>
          <span class="display hero__l2">Discord <span class="glow-yellow">TEC 2026</span></span>
        </h1>
        <p class="hero__lead">
          Belum pernah pakai Discord? Tenang. Situs ini mengajarimu <b>langkah demi langkah</b>, dari membuat akun sampai <b>melapor hasil laga</b>, lewat tayangan yang bisa kamu <b class="y">tonton</b> atau <b class="y">coba sendiri</b>.
        </p>

        <ol class="how">
          {
            how.map((h) => (
              <li class="how__item">
                <span class="how__no">{h.no}</span>
                <span>
                  <b>{h.title}</b>
                  <small>{h.text}</small>
                </span>
              </li>
            ))
          }
        </ol>

        <div class="hero__cta">
          <a class="btn btn--primary" href={`${base}/misi/${first.slug}/`}>▶ Mulai dari Misi 00</a>
          <a class="btn btn--ghost" href={`${base}/misi/${report.slug}/`}>Langsung: {report.title}</a>
        </div>
      </div>

      <div class="hero__art">
        <div class="hero__ribbon" aria-hidden="true">
          <Ribbon d={hero.d} viewBox="0 0 980 720" unit={7} dots={heroDots} from="#59a8ff" to="var(--blue)" />
        </div>
        <HeroDemo label="Contoh tayangan · Misi 05" />
      </div>
    </div>
  </section>

  <TournamentInfo locale={locale} />

  <section class="section section--map wrap" id="peta-misi" aria-labelledby="peta-misi-title">
    <div class="section__head">
      <div>
        <p class="hud hud--yellow">// {t('nav.missions')}</p>
        <h2 id="peta-misi-title" class="section__title display">Pilih misimu</h2>
      </div>
      <p class="section__lead">
        Baru pertama kali? Ikuti dari <b>Misi 00</b>. Yang paling penting untuk kompetisi:{' '}
        {
          keyMissions.map((m, i) => (
            <>
              {i > 0 && ' dan '}
              <a href={`${base}/misi/${m.slug}/`}>
                Misi {String(m.no).padStart(2, '0')} {m.title}
              </a>
            </>
          ))
        }.
      </p>
    </div>
    <MissionMap missions={list} locale={locale} />
  </section>

  <section class="section wrap" aria-labelledby="kenapa">
    <p class="hud hud--yellow">// Kenapa Discord?</p>
    <h2 id="kenapa" class="section__title display">Satu tempat untuk semua urusan laga</h2>
    <div class="why">
      {
        why.map((w) => (
          <article class="why__card glass hud-corners">
            <span class="why__icon">{w.icon}</span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section wrap" aria-labelledby="game">
    <p class="hud hud--yellow">// Game yang dipertandingkan</p>
    <h2 id="game" class="section__title display">6 game, satu cara lapor</h2>
    <ul class="games">
      {
        games.map((g) => (
          <li class="games__item glass">
            <b class="games__name">{g.name}</b>
            <span class="games__full">{g.full}</span>
            <span class="chip">{g.report}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-block: clamp(28px, 5vw, 56px) 8px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: 32px;
  }

  .hero__copy {
    display: grid;
    gap: 20px;
    position: relative;
    z-index: 2;
  }

  .hero__title {
    display: grid;
    gap: 6px;
  }

  .hero__l1 {
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
  }

  .hero__l2 {
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
  }

  .hero__lead {
    max-width: 54ch;
    font-size: 1.18rem;
    color: var(--text-muted);
  }

  .hero__lead b {
    color: var(--text);
  }

  .hero__lead b.y {
    color: var(--yellow);
  }

  .how {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .how__item {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid var(--line);
  }

  .how__no {
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--yellow);
    font-size: 0.85rem;
    padding-top: 2px;
  }

  .how__item b {
    display: block;
    line-height: 1.25;
  }

  .how__item small {
    display: block;
    margin-top: 2px;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__art {
    position: relative;
    display: grid;
  }

  .hero__ribbon {
    position: absolute;
    inset: 4% -14% 0 -14%;
    opacity: 0.55;
    pointer-events: none;
  }

  .hero__ribbon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .section {
    padding-top: clamp(56px, 8vw, 110px);
    display: grid;
    gap: 16px;
  }

  .section--map {
    padding-top: clamp(40px, 5vw, 64px);
  }

  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin-bottom: 8px;
  }

  .section__title {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    max-width: 18ch;
  }

  .section__lead {
    max-width: 52ch;
    color: var(--text-muted);
  }

  .section__lead b {
    color: var(--text);
  }

  .why {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 16px;
  }

  .why__card {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 24px;
  }

  .why__icon {
    font-size: 2rem;
  }

  .why__card h3 {
    font-size: 1.25rem;
    font-weight: 900;
  }

  .why__card p {
    color: var(--text-muted);
  }

  .games {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .games__item {
    display: grid;
    gap: 4px;
    justify-items: start;
    padding: 18px 20px;
  }

  .games__name {
    font-size: 1.5rem;
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
  }

  .games__full {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 6px;
  }

  @media (max-width: 640px) {
    .how {
      gap: 6px;
    }

    .how__item {
      flex-direction: column;
      gap: 2px;
      padding: 10px;
    }

    .how__item b {
      font-size: 0.85rem;
    }

    .how__item small {
      display: none;
    }

    .hero__lead {
      font-size: 1.05rem;
    }

    .hero__cta .btn {
      flex: 1 1 auto;
      min-height: 44px;
      padding: 0.6em 1em;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    /* the mission map comes first on small screens; the demo lives inside each mission */
    .hero__art {
      display: none;
    }

    .why {
      grid-template-columns: 1fr;
    }

    .games {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .games {
      grid-template-columns: 1fr;
    }
  }
</style>
